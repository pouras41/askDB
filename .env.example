# Copy this file to .env and paste a free Gemini API key.
# Create one at https://aistudio.google.com/apikey (no credit card on the free tier).

GEMINI_API_KEY=
# Free-tier model with a higher daily request allowance than the larger Flash models.
# Other free-tier options include gemini-3.8-flash and gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Used to sign JWTs and to encrypt saved database passwords. Change this.
JWT_SECRET=replace-with-a-long-random-string

# Local Postgres credentials. Avoid @ : / in the password (they break the URL).
POSTGRES_USER=askdb
POSTGRES_PASSWORD=askdb_local_password
POSTGRES_DB=askdb

# Per-user limits, kept under the Gemini free-tier request rate.
QUERY_RATE_LIMIT=8
QUERY_DAILY_LIMIT=40
